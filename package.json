{
  "name": "collaflow-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "CollaFlow — 高性能协同脑图框架，支持 MCP 协议与私有化部署",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"@collaflow/*\" run dev",
    "build": "pnpm --filter \"@collaflow/*\" run build",
    "test": "pnpm --filter \"@collaflow/*\" run test",
    "typecheck": "pnpm --filter \"@collaflow/*\" run typecheck",
    "coverage": "pnpm --filter @collaflow/markdown run test:coverage",
    "clean": "pnpm --filter \"@collaflow/*\" run clean",
    "lint": "pnpm --filter \"@collaflow/*\" run lint",
    "publish:all": "pnpm -r publish --access public",
    "skills:validate": "node scripts/skill-governance.mjs",
    "commit": "cz",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog",
      "scopes": [
        "core",
        "collab-core",
        "markdown",
        "mind",
        "app",
        "root",
        "deps",
        "ci",
        "release",
        "skills"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "human-id": "4.1.1",
      "fastify": "5.11.3"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^20.17.6",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "ajv": "^8.17.1",
    "lint-staged": "^15.5.2",
    "rimraf": "^5.0.10",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
