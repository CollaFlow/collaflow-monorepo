{
  "name": "@collaflow/collamarkdown",
  "version": "0.0.0",
  "private": true,
  "description": "CollaMarkdown — CollaFlow 协作文档（Markdown 解析与协同编辑）",
  "license": "Apache-2.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@milkdown/core": "^7.22.1",
    "@milkdown/ctx": "^7.22.1",
    "@milkdown/plugin-block": "^7.22.1",
    "@milkdown/plugin-listener": "^7.22.1",
    "@milkdown/plugin-prism": "^7.22.1",
    "@milkdown/preset-commonmark": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "refractor": "^5.0.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@milkdown/transformer": "^7.22.1",
    "jsdom": "^24.1.3"
  }
}
